{
  "name": "kindle-reader",
  "version": "1.0.1",
  "description": "Read EPUB, FB2 and PDF books inside Obsidian, with highlights, notes, and reading progress that syncs with your vault.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "postinstall": "node patch-pdfjs.cjs",
    "dev": "cross-env PLUGIN_DIR=vault/.obsidian/plugins/kindle-reader node esbuild.config.mjs",
    "build": "cross-env PLUGIN_DIR=vault/.obsidian/plugins/kindle-reader node esbuild.config.mjs production && node patch-pdfjs.cjs",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "epub",
    "fb2",
    "pdf",
    "reader",
    "highlights"
  ],
  "author": "Bernardo",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "jsdom": "^29.1.1",
    "obsidian": "latest"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "pdfjs-dist": "^6.2.108",
    "translate-google": "^1.5.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "tar": "^7.5.22"
  }
}
